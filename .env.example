# Il modo piu' semplice e' non copiare questo file a mano: `./setup.sh` ne
# ricava un `.env` con due password casuali gia' dentro.
#
#   ./setup.sh
#   docker compose up -d --build
#
# Copiandolo a mano (`cp .env.example .env`), cambia le due password qui sotto.
#
# Poi apri http://localhost:3010 e crea il primo account dalla schermata di
# accesso: l'app parte vuota, senza dati di nessuno.

# --- le due password del database -------------------------------------------
# La prima e' del proprietario, la seconda del ruolo con cui l'app si collega:
# e' senza privilegi apposta, perche' e' su di lui che agisce l'isolamento fra
# gli utenti. Mettine due lunghe e diverse.
POSTGRES_PASSWORD=cambia-questa-password
MONEY_APP_DB_PASSWORD=cambia-anche-questa

# --- dove si apre -------------------------------------------------------------
# Porta dell'interfaccia e porta con cui parlare direttamente all'API
# (l'interfaccia non ne ha bisogno: passa dal gateway).
MONEY_WEB_PORT=3010
MONEY_API_PORT=8000

# 127.0.0.1 = raggiungibile solo da questo computer.
# 0.0.0.0 = raggiungibile dagli altri dispositivi: usalo su un NAS, e mettici
# davanti una rete privata tipo Tailscale invece di aprire porte sul router.
MONEY_BIND_ADDRESS=127.0.0.1

# L'indirizzo da cui aprirai l'app, se diverso da localhost.
MONEY_APP_ORIGIN=http://localhost:3010

# --- fuso orario --------------------------------------------------------------
# Conta davvero: decide qual e' "oggi" per i giorni del periodo e per la
# freschezza delle quotazioni.
MONEY_TZ=Europe/Rome

# --- sicurezza ----------------------------------------------------------------
# Il cookie di sessione prende il flag Secure da solo quando MONEY_APP_ORIGIN
# qui sopra comincia per https://, quindi di norma non serve toccare niente.
# Questa variabile e' solo lo scavalco per i casi storti - per esempio un proxy
# che parla HTTPS al browser e HTTP all'app. Lasciala vuota per l'automatico.
# MONEY_COOKIE_SECURE=

# --- facoltativo --------------------------------------------------------------
# Cartella che contiene un vecchio Money.xlsx, se ne hai uno. Serve solo ai test
# di parita', che confrontano i calcoli dell'app con quel foglio; senza, quei
# test vengono saltati e tutto il resto funziona lo stesso.
# MONEY_XLSX_HOST_DIR=/percorso/della/cartella
